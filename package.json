{
  "name": "ai-customer-assistance",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "test": "tsx scripts/test-embeddings.mts && tsx scripts/test-vector-store.mts && tsx scripts/test-vectorize-store.mts && tsx scripts/test-retriever.mts && tsx scripts/test-rag-config.mts && tsx scripts/test-rag-index.mts && tsx scripts/test-rag-integration.mts && tsx scripts/test-faq-search.mts",
    "test:e2e": "tsx scripts/test-e2e-rag.mts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.312",
    "@tdesign-react/chat": "^1.0.2",
    "@tencent-ai/agent-sdk": "^0.3.43",
    "better-sqlite3": "^12.6.2",
    "dotenv": "^18.0.9",
    "express": "^4.18.2",
    "lucide-react": "^0.563.0",
    "opencc-js": "^1.4.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.13.0",
    "sqlite-vec": "^0.1.9",
    "tdesign-icons-react": "^0.5.0",
    "tdesign-react": "^1.12.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "less": "^4.3.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.6.2",
    "typescript": "^5.3.2",
    "vite": "^5.0.10"
  },
  "description": "AI Customer Assistance - 基于 Claude Code Agent SDK 的智能客服 Web 应用"
}
