# ==================== Provider 选择 ====================
# claude    : Claude Code Agent SDK（默认，配合 MiniMax 使用）
# codebuddy : CodeBuddy Agent SDK
AGENT_PROVIDER=claude

# ==================== Claude Code (MiniMax) ====================
# MiniMax API Key（从 https://platform.minimaxi.com 获取）
ANTHROPIC_AUTH_TOKEN=your-api-key-here

# Anthropic 兼容端点
ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic

# 默认模型（可从 /api/models 拉取账号下可用的模型列表）
ANTHROPIC_MODEL=MiniMax-M3.1-Flash

# ==================== CodeBuddy（备用 Provider）====================
# CodeBuddy API Key（从 https://www.codebuddy.cn 获取）
# CODEBUDDY_API_KEY=your-api-key-here

# 可选：自定义服务端口
# PORT=3001

# 可选：网络环境（iOA / external）
# CODEBUDDY_INTERNET_ENVIRONMENT=external

# 可选：CodeBuddy 服务地址
# CODEBUDDY_BASE_URL=

# ==================== 向量检索（RAG）====================
# 开关。off 时完全不发起 embedding 请求，系统退化为纯关键词检索。
# 打开后如果 embedding 不可用（没配 key / 配额限流 / 服务异常），
# 检索层会自动降级回关键词检索，客服始终能回答。
VECTOR_SEARCH=off

# 向量库后端：sqlite（本地，默认，136KB 插件、零延迟）| vectorize（Cloudflare 托管）
VECTOR_STORE=sqlite

# 默认使用 Cloudflare Workers AI 的 embedding 模型（有免费额度，不按 RPM 限流）。
# baseUrl 里要带上你的 Account ID（Cloudflare dashboard 右上角账号名旁边可见）：
# EMBEDDING_BASE_URL=https://api.cloudflare.com/client/v4/accounts/你的ACCOUNT_ID/ai/run
# EMBEDDING_MODEL=@cf/baai/bge-m3
# EMBEDDING_PROTOCOL=cloudflare
# EMBEDDING_API_KEY=cfut-...

# Cloudflare Vectorize（VECTOR_STORE=vectorize 时需要）。
# token 需要 Account → Workers AI → Read 与 Account → Vectorize → Edit 两项权限。
# VECTORIZE_ACCOUNT_ID=你的ACCOUNT_ID
# VECTORIZE_INDEX=scs-faq
# VECTORIZE_API_KEY=        # 不填则复用 EMBEDDING_API_KEY

# 换成 MiniMax（需要该 key 有 embedding 配额；不填 EMBEDDING_API_KEY 则回退到
# 上面的 ANTHROPIC_AUTH_TOKEN）：
# EMBEDDING_BASE_URL=https://api.minimax.io/v1
# EMBEDDING_MODEL=embo-01
# EMBEDDING_PROTOCOL=minimax

# embedding 请求超时（毫秒）
# EMBEDDING_TIMEOUT_MS=5000

# 检索返回条数
# RAG_TOP_K=3
